# ============ 基础配置 ============
# 节点 UUID（必填）。生成方式：bash scripts/setup.sh 会自动生成，
# 或手动执行：cat /proc/sys/kernel/random/uuid
UUID=

# 伪装网页 + 订阅监听端口（容器内）。
# 保持 3001：sing-box 的 HTTP fallback 目标被写死为 3001，
# 只有这样通过隧道访问 https://你的域名/ 才能看到伪装网页、/jl 才能取订阅。
PORT=3001

# sing-box 入口端口（容器内），Cloudflare 隧道要指向这个端口
ARGO_PORT=8080

# 节点名称（显示在客户端里的名字）
NAME=US-Google_Cloud

# 运行数据目录（二进制、config.json、sub.txt 都放这里）
# FILE_PATH=.tmp

# ============ Cloudflare Argo 隧道（必填，必须用自己的） ============
# 方式 A（推荐）：Cloudflare Zero Trust -> Networks -> Tunnels 创建隧道后复制的 Token
# 形如 eyJhIjoi... 的长字符串
ARGO_AUTH=

# 方式 B：隧道凭据 JSON（cloudflared tunnel create 生成的 credentials 文件内容，
# 含 TunnelSecret 字段时脚本会自动识别）
# ARGO_AUTH={"AccountTag":"...","TunnelSecret":"...","TunnelID":"..."}

# 隧道绑定的域名，必须与 Cloudflare 后台给该隧道配置的 Public Hostname 一致，
# 并且该 Public Hostname 的 Service 要指向 http://localhost:8080
ARGO_DOMAIN=node.example.com

# 客户端连接用的地址（一般填你的隧道域名；也可填 Cloudflare 优选 IP）
# 留空会退回到脚本内置的第三方域名，务必自己指定
CFIP=node.example.com

# 客户端连接端口，走 Cloudflare 就是 443
CFPORT=443

# ============ 订阅 ============
# 订阅路径：http://127.0.0.1:3001/<SUB_PATH>，返回 base64 编码的节点链接
SUB_PATH=jl

# ============ 哪吒监控（可选，不需要就留空） ============
NEZHA_SERVER=
NEZHA_PORT=
NEZHA_KEY=
