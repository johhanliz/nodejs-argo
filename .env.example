# ============================================================
# nodejs-argo 环境变量示例
# 复制成 .env 后修改；docker compose / 平台面板都能直接用。
# 只有 ARGO_AUTH / ARGO_DOMAIN / UUID 这三项需要你关心。
# ============================================================

# 节点 UUID（客户端里的 id），随便生成一个，例如：
#   node -e "console.log(crypto.randomUUID())"
# 不填会自动生成并保存到 data/uuid
UUID=

# Argo 模式一：Cloudflare Tunnel token（推荐，域名固定）
# Zero Trust -> Networks -> Tunnels -> 创建隧道 -> 复制 token
# 形如 eyJhIjoi... 的一长串；留空则使用临时隧道
ARGO_AUTH=

# 隧道的公开域名，必须和 Cloudflare 里给隧道绑定的 hostname 一致
# 例如 node.example.com（不要带 https://）
ARGO_DOMAIN=

# Argo 模式二：完整凭据 JSON（含 TunnelSecret）时，把整个 JSON 塞进 ARGO_AUTH，
# 同时设置 ARGO_DOMAIN，程序会自动生成 tunnel.yml。

# ---------------- 以下一般不用改 ----------------

# 本地 HTTP 端口（状态页 + 订阅）。平台通常会自动注入 PORT
PORT=3000

# 订阅路径：https://你的域名/<SUB_PATH>
SUB_PATH=sub

# Xray 监听端口，Cloudflare 隧道回源到这个端口，不要和 PORT 相同
ARGO_PORT=8001

# 节点名后缀，例如 HK 会生成 "HK-你的域名"
NAME=

# 优选 IP / 优选域名（可选）。不填就用你的 Argo 域名
CFIP=
CFPORT=443

# GitHub 下载加速前缀（大陆机器可选），例如 https://ghfast.top
DOWNLOAD_MIRROR=

# 数据目录（下载的二进制、uuid、配置都放这里）
DATA_DIR=
